      </attribute>
      <layout class="QVBoxLayout" name="dpi_layout">
       <item>
        <widget class="QLabel" name="dpi_intro">
         <property name="text">
          <string>Makes blocked sites reachable over the direct outbound, without a proxy. Needs Tun Mode; the elevated privileges Tun already requests are enough. Not available on Windows ARM.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
