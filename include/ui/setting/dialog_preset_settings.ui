            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="dpi_spoof_method_l">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How the decoy packet is made invalid for the server while still convincing DPI. Which one works depends on your ISP, so try them in order.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Desync</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="dpi_spoof_method"/>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="dpi_block_quic">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;There is no desync for QUIC, so blocking it makes browsers fall back to TLS over TCP, where the bypass works.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
