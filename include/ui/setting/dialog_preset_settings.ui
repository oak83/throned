         </property>
         <layout class="QFormLayout" name="dpi_form">
          <item row="0" column="0">
           <widget class="QLabel" name="dpi_method_l">
            <property name="text">
             <string>Method</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="dpi_method"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="dpi_spoof_sni_l">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A decoy ClientHello carrying this name is sent before the real one, so DPI classifies the flow by the decoy. Pick a name your network lets through.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Spoof SNI</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="dpi_spoof_sni">
